{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run qbiotic-flow Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-extension",
        "${workspaceFolder}/examples/minimal-pipeline"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-extension/dist/**/*.js"
      ],
      "preLaunchTask": "Build qbiotic-flow Extension"
    }
  ]
}
