{
  "name": "nextflow-ide",
  "publisher": "nextflow-ide",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "displayName": "Nextflow IDE",
  "description": "VS Code extension scaffold for the Nextflow IDE MVP.",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:main.nf",
    "onCommand:nextflowIde.runPipeline",
    "onCommand:nextflowIde.resumeRun",
    "onCommand:nextflowIde.stopRun"
    ,"onCommand:nextflowIde.showRunDetails"
    ,"onCommand:nextflowIde.openArtifact"
    ,"onCommand:nextflowIde.selectWorkspaceRoot"
    ,"onView:nextflowIde.runs"
  ],
  "contributes": {
    "commands": [
      {
        "command": "nextflowIde.runPipeline",
        "title": "Nextflow: Run Pipeline"
      },
      {
        "command": "nextflowIde.resumeRun",
        "title": "Nextflow: Resume Run"
      },
      {
        "command": "nextflowIde.stopRun",
        "title": "Nextflow: Stop Run"
      },
      {
        "command": "nextflowIde.showRunDetails",
        "title": "Nextflow: Show Run Details"
      },
      {
        "command": "nextflowIde.openArtifact",
        "title": "Nextflow: Open Artifact"
      },
      {
        "command": "nextflowIde.selectWorkspaceRoot",
        "title": "Nextflow: Select Workspace Root"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "nextflowIde.runs",
          "name": "Nextflow Runs"
        }
      ]
    }
  },
  "keywords": ["nextflow", "vscode", "bioinformatics"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nextflow-ide/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nextflow-ide/application": "workspace:*",
    "@nextflow-ide/domain": "workspace:*",
    "@nextflow-ide/runtime-adapters": "workspace:*",
    "@nextflow-ide/state-adapters": "workspace:*",
    "@nextflow-ide/workspace-adapters": "workspace:*",
    "tslib": "^2.3.0"
  }
}
