{
  "name": "qbiotic-flow",
  "publisher": "qbiotic-flow",
  "author": {
    "name": "Pablo Pimàs Verge",
    "email": "pablo@pimas.cat"
  },
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "displayName": "qbiotic-flow",
  "description": "A local Nextflow development experience for Visual Studio Code.",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": ["Other"],
  "activationEvents": ["workspaceContains:main.nf"],
  "contributes": {
    "commands": [
      {
        "command": "nextflowIde.runPipeline",
        "title": "qbiotic-flow: Run Pipeline"
      },
      {
        "command": "nextflowIde.resumeRun",
        "title": "qbiotic-flow: Resume Run"
      },
      {
        "command": "nextflowIde.stopRun",
        "title": "qbiotic-flow: Stop Run"
      },
      {
        "command": "nextflowIde.showRunDetails",
        "title": "qbiotic-flow: Show Run Details"
      },
      {
        "command": "nextflowIde.openArtifact",
        "title": "qbiotic-flow: Open Artifact"
      },
      {
        "command": "nextflowIde.selectWorkspaceRoot",
        "title": "qbiotic-flow: Select Workspace Root"
      }
    ],
    "views": {
      "qbioticFlow": [
        {
          "id": "nextflowIde.runs",
          "name": "qbiotic-flow Runs"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "nextflowIde.runs",
        "contents": "Run a Nextflow pipeline to see its executions here.\n\n[Run Pipeline](command:nextflowIde.runPipeline)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qbioticFlow",
          "title": "qbiotic-flow",
          "icon": "./qbiotic.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "nextflowIde.runPipeline",
          "when": "view == nextflowIde.runs",
          "group": "navigation",
          "icon": "$(play)"
        }
      ]
    }
  },
  "keywords": ["nextflow", "vscode", "bioinformatics"],
  "main": "./dist/extension.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@nextflow-ide/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@nextflow-ide/application": "workspace:*",
    "@nextflow-ide/domain": "workspace:*",
    "@nextflow-ide/runtime-adapters": "workspace:*",
    "@nextflow-ide/state-adapters": "workspace:*",
    "@nextflow-ide/workspace-adapters": "workspace:*",
    "tslib": "^2.3.0"
  }
}
