{
  "name": "vscode-extension",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/vscode-extension/src",
  "projectType": "library",
  "tags": ["scope:edge", "layer:extension"],
  "// targets": "to see all targets run: nx show project vscode-extension --web",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config vitest.config.mts packages/vscode-extension/tests"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "mkdir -p ../../dist && ../../node_modules/.bin/vsce package --no-dependencies --skip-license --allow-missing-repository --out ../../dist/qbiotic-flow.vsix",
        "cwd": "packages/vscode-extension"
      }
    }
  }
}
